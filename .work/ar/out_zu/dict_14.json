"awaADeux.partnerSide.profile.faq.howItWorksTitle": "I-AWA Together isebenza kanjani?",
"awaADeux.partnerSide.profile.faq.howItWorksDescription": "Funda ukuthi uhlelo lukuvumela kanjani ukuthi usekele umlingani wakho ngenkathi luhlonipha ubumfihlo bakhe.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph1": "I-AWA Together ikuvumela ukuthi ubuke kuphela ulwazi umlingani wakho akhethe ukwabelana nawe ngalo.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph2": "Isibonelo, ungabona ulwazi oluthile mayelana nomjikelezo wakhe, isikhathi sakhe esilandelayo, noma isikhathi sakhe sokukhulelwa uma ukwabelana kuvuliwe kuzo.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph3": "Ulwazi olubonakalayo lufuze njalo ukukhetha kwakhe. Angashintsha lokho akwabelanayo noma yinini.",
"awaADeux.partnerSide.profile.faq.hiddenInfoTitle": "Kungani olunye ulwazi lufihliwe?",
"awaADeux.partnerSide.profile.faq.hiddenInfoDescription": "Umlingani wakho ukhetha lokho akwabelana nawe. Angashintsha lokhu kukhetha noma yinini.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph1": "Umlingani wakho uhlala enegunya phezu kolwazi afuna ukwabelana nawe ngalo.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph2": "Uma ulwazi lungavezi esikhaleni sakho, kungase kusho nje ukuthi akakhethanga ukwabelana ngalo.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph3": "Ukukhetha kwakhe kungashintsha noma yinini. I-AWA Together ikubonisa kuphela ulwazi onokufinyelela kulo okwamanje.",
"awaADeux.partnerSide.profile.faq.understandingTitle": "Ukuqonda ulwazi olwabiwe",
"awaADeux.partnerSide.profile.faq.understandingDescription": "Incazelo elula yosuku lomjikelezo, isigaba samanje, isikhathi sokukhulelwa, i-ovulation elindelekile, nesikhathi esilandelayo.",
"awaADeux.partnerSide.profile.faq.understandingIntro": "Nakhu okungase kusho ulwazi olwabiwe nawe:",
"awaADeux.partnerSide.profile.faq.termCycleDay": "Usuku lomjikelezo",
"awaADeux.partnerSide.profile.faq.descriptionCycleDay": "Lubonisa inani lezinsuku kusukela ekuqaleni kwesikhathi sakhe sokugcina.",
"awaADeux.partnerSide.profile.faq.termCurrentPhase": "Isigaba samanje",
"awaADeux.partnerSide.profile.faq.descriptionCurrentPhase": "Sibonisa isigaba samanje somjikelezo uma sitholakala.",
"awaADeux.partnerSide.profile.faq.termFertileWindow": "Isikhathi sokukhulelwa",
"awaADeux.partnerSide.profile.faq.descriptionFertileWindow": "Isikhathi esilindelekile lapho ithuba lokukhulelwa lingaba likhulu.",
"awaADeux.partnerSide.profile.faq.termOvulation": "I-ovulation elindelekile",
"awaADeux.partnerSide.profile.faq.descriptionOvulation": "Isilinganiso sokuthi i-ovulation yenzeka nini, ngokolwazi olutholakalayo.",
"awaADeux.partnerSide.profile.faq.termNextPeriod": "Isikhathi esilandelayo esilindelekile",
"awaADeux.partnerSide.profile.faq.descriptionNextPeriod": "Usuku olulindelekile lokuqala kwesikhathi sakhe esilandelayo.",
"awaADeux.partnerSide.profile.faq.termPeriodStatus": "Isimo sesikhathi",
"awaADeux.partnerSide.profile.faq.descriptionPeriodStatus": "Sibonisa ukuthi isikhathi sakhe siyaqhubeka yini noma siphelile.",
"awaADeux.partnerSide.profile.faq.troubleshootingTitle": "Nginenkinga nge-AWA Together",
"awaADeux.partnerSide.profile.faq.troubleshootingDescription": "Okufaneleukwenze uma ulwazi lungavezi, uxhumo lubonakala luphazamiseke, noma uma unenye inkinga.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph1": "Uma olunye ulwazi lungavezi, qala ngokuhlola ukuthi uxhumo lwakho lwe-inthanethi lusebenza kahle.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph2": "Olunye ulwazi lungase lungabikho nje ngoba umlingani wakho akabelani ngalo okwamanje.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph3": "Ungazama futhi ukuvala uphinde uvule i-app.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph4": "Uma inkinga iqhubeka, uzokwazi ukuxhumana nosizo lwe-AWA.",
"awaADeux.partnerSide.profile.faq.contactSupportTitle": "Xhumana nosizo",
"awaADeux.partnerSide.profile.faq.contactSupportDescription": "Udinga usizo olwengeziwe? Ithimba lethu lilapha ukukusekela.",
"awaADeux.partnerSide.profile.faq.contactSupportParagraph1": "Uma unombuzo, uhlangana nenkinga, noma ufuna ukusinika impendulo, ungaxhumana nethimba le-AWA kulesi sigaba.",
"awaADeux.partnerSide.profile.faq.contactSupportParagraph2": "Siyabonga ngokusisiza ukuthuthukisa i-AWA! 💜",
"awaADeux.partnerSide.profile.faq.contactButton": "Sibhalele",
"awaADeux.partnerSide.profile.faq.contactAccessibility": "Xhumana nathi nge-imeyili",
"awaADeux.partnerSide.profile.faq.contactEmailSubject": "Usizo — AWA Together",
