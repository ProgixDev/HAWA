  "awaADeux.partnerSide.profile.faq.howItWorksTitle": "Isebenza njani i- AWA Together?",
  "awaADeux.partnerSide.profile.faq.howItWorksDescription": "Funda indlela le app ekuvumela ngayo ukuba umxhase iqabane lakho ngoxa uhlonipha ubumfihlo balo.",
  "awaADeux.partnerSide.profile.faq.howItWorksParagraph1": "I-AWA Together ikuvumela ukuba ubukele kuphela inkcazelo ekhethwe liqabane lakho ukuba liyinike.",
  "awaADeux.partnerSide.profile.faq.howItWorksParagraph2": "Ngokomzekelo, usenokubona inkcazelo ethile ngokuphathelele umjikelo wakhe, ixesha lakhe elilandelayo, okanye ifestile yakhe yokuzala xa bebelana.",
  "awaADeux.partnerSide.profile.faq.howItWorksParagraph3": "Ulwazi olubonakalayo lusoloko luxhomekeke kukhetho lwakhe.",
  "awaADeux.partnerSide.profile.faq.hiddenInfoTitle": "Kutheni kukho izinto ezifihlakeleyo?",
  "awaADeux.partnerSide.profile.faq.hiddenInfoDescription": "Iqabane lakho likhetha into eliyabelana ngayo nawe.",
  "awaADeux.partnerSide.profile.faq.hiddenInfoParagraph1": "Iqabane lakho lilawula ulwazi afuna ukuxelela lona.",
  "awaADeux.partnerSide.profile.faq.hiddenInfoParagraph2": "Ukuba ulwazi alubonakali kwindawo yakho, kusenokuthetha nje ukuba akakhange akhethe ukuwabelana ngalo.",
  "awaADeux.partnerSide.profile.faq.hiddenInfoParagraph3": "AWA Together ibonisa kuphela ulwazi okwangoku onalo.",
  "awaADeux.partnerSide.profile.faq.understandingTitle": "Ukuqonda ulwazi oluhlanganisiweyo",
  "awaADeux.partnerSide.profile.faq.understandingDescription": "Iinkcazo ezilula zosuku lomjikelo, isigaba sangoku, iwindow yokuzala, ukuqikelelwa kokuqhomfa, kunye nexesha elilandelayo.",
  "awaADeux.partnerSide.profile.faq.understandingIntro": "Nantsi into enokuthethwa lulwazi olukwabelwana ngalo nawe:",
  "awaADeux.partnerSide.profile.faq.termCycleDay": "Usuku lomjikelo",
  "awaADeux.partnerSide.profile.faq.descriptionCycleDay": "Kubonisa inani leentsuku ukususela ekuqaleni kwexesha lakhe lokugqibela.",
  "awaADeux.partnerSide.profile.faq.termCurrentPhase": "Isigaba sangoku",
  "awaADeux.partnerSide.profile.faq.descriptionCurrentPhase": "Kubonisa isigaba sangoku somjikelo xa sikhona.",
  "awaADeux.partnerSide.profile.faq.termFertileWindow": "Iwindow enobunewunewu",
  "awaADeux.partnerSide.profile.faq.descriptionFertileWindow": "Ixesha eliqikelelweyo apho amathuba okuzala anokuba ngaphezulu.",
  "awaADeux.partnerSide.profile.faq.termOvulation": "Ukuqhekeka kweqanda",
  "awaADeux.partnerSide.profile.faq.descriptionOvulation": "Uqikelelo lwexesha lokuvela kwe-ovulation, ngokusekelwe kulwazi olukhoyo.",
  "awaADeux.partnerSide.profile.faq.termNextPeriod": "Ixesha elilandelayo eliqikelelweyo",
  "awaADeux.partnerSide.profile.faq.descriptionNextPeriod": "Umhla oqikelelweyo wokuqalisa kwexesha lakhe elilandelayo.",
  "awaADeux.partnerSide.profile.faq.termPeriodStatus": "Imeko yexesha",
  "awaADeux.partnerSide.profile.faq.descriptionPeriodStatus": "Kubonisa ukuba ixesha lakhe liqhubeka okanye liphelile.",
  "awaADeux.partnerSide.profile.faq.troubleshootingTitle": "Ndinenkinga ngeAWA Together",
  "awaADeux.partnerSide.profile.faq.troubleshootingDescription": "Yintoni omele uyenze ukuba ulwazi alubonakali, uqhagamshelo lubonakala luphazanyisiwe, okanye unenye ingxaki.",
  "awaADeux.partnerSide.profile.faq.troubleshootingParagraph1": "Ukuba kukho ulwazi olungabonisiyo, qala ngokujonga ukuba uqhagamshelo lwakho lwe-intanethi lusebenza kakuhle.",
  "awaADeux.partnerSide.profile.faq.troubleshootingParagraph2": "Olunye ulwazi lunokuphulukana nje kuba iqabane lakho lingaluhambelani.",
  "awaADeux.partnerSide.profile.faq.troubleshootingParagraph3": "Unokuzama nokuvala nokuvula kwakhona usetyenziso.",
  "awaADeux.partnerSide.profile.faq.troubleshootingParagraph4": "Ukuba ingxaki iyaqhubeka, uya kukwazi ukuqhagamshelana nenkxaso yeAWA.",
  "awaADeux.partnerSide.profile.faq.contactSupportTitle": "Inkxaso yokuqhagamshelana",
  "awaADeux.partnerSide.profile.faq.contactSupportDescription": "Ufuna uncedo olungakumbi? Iqela lethu lilapha ukuze likuxhase.",
  "awaADeux.partnerSide.profile.faq.contactSupportParagraph1": "Ukuba unemibuzo, ufumana ingxaki, okanye ufuna ukusinika ingxelo, ungaqhagamshelana neqela leAWA elivela kweli candelo.",
