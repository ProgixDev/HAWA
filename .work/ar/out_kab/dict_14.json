"awaADeux.partnerSide.profile.logoutModal.title": "Ffeɣ?",
"awaADeux.partnerSide.profile.logoutModal.body": "Tebɣiḍ s tidet ad teffɣeḍ seg tallunt-ik n umdan?",
"awaADeux.partnerSide.profile.logoutModal.reassurance": "Tzemreḍ ad tuɣaleḍ ad tkecmeḍ melmi i tebɣiḍ.",
"awaADeux.partnerSide.profile.faq.howItWorksTitle": "Amek i iteddu AWA Together?",
"awaADeux.partnerSide.profile.faq.howItWorksDescription": " Issin amek i k-yeǧǧa usnas ad tɛawneḍ amdan-ik s wudem i iḥrez tabaḍnit-is.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph1": "AWA Together ak-yeǧǧa ad twaliḍ kan talɣut i d-yefren umdan-ik ad tebḍu yid-k.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph2": "Amedya, tzemreḍ ad twaliḍ kra n talɣut ɣef cycle-is, lḥiḍ-is i d-iteddun, neɣ tantalt n tfruxt-is mi yella ubeḍḍu irmed i-sen.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph3": "Talɣut i d-tettbanen tettwabna ɣef ufran-is. Izmer ad ibeddel ayen ibeḍḍu melmi i yebɣa.",
"awaADeux.partnerSide.profile.faq.hiddenInfoTitle": "Acimi kra n talɣut tuffer?",
"awaADeux.partnerSide.profile.faq.hiddenInfoDescription": "Amdan-ik yefren ayen ibeḍḍu yid-k. Izmer ad ibeddel afran-a melmi i yebɣa.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph1": "Amdan-ik yeqqim d ameqran ɣef talɣut i yebɣa ad yebḍu yid-k.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph2": "Ma talɣut ur d-tettban ara deg tallunt-ik, aya izmer ad d-yini kan ur tefri ara ad tt-ibḍu.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph3": "Ifranen-is zemren ad beddlen melmi i yebɣa. AWA Together ad k-yesken kan talɣut i tzemreḍ ad tawḍeḍ ɣer-s tura.",
"awaADeux.partnerSide.profile.faq.understandingTitle": "Fhem talɣut yettwabḍan",
"awaADeux.partnerSide.profile.faq.understandingDescription": "Tifesniwin tifusanin ɣef ass n cycle, usurif n tura, tantalt n tfruxt, ovulation yettwanqes, d lḥiḍ i d-iteddun.",
"awaADeux.partnerSide.profile.faq.understandingIntro": "Ha-t wayen izemren ad d-ini talɣut yettwabḍan yid-k:",
"awaADeux.partnerSide.profile.faq.termCycleDay": "Ass n cycle",
"awaADeux.partnerSide.profile.faq.descriptionCycleDay": "Isken amḍan n wussan seg tazwara n lḥiḍ-is aneggaru.",
"awaADeux.partnerSide.profile.faq.termCurrentPhase": "Asurif n tura",
"awaADeux.partnerSide.profile.faq.descriptionCurrentPhase": "Isken asurif n tura n cycle ma yella.",
"awaADeux.partnerSide.profile.faq.termFertileWindow": "Tantalt n tafruxt",
"awaADeux.partnerSide.profile.faq.descriptionFertileWindow": "Tawalt yettwanqes anda tezmer tezmert n uɣbel ad tili ugar.",
"awaADeux.partnerSide.profile.faq.termOvulation": "Ovulation yettwanqes",
"awaADeux.partnerSide.profile.faq.descriptionOvulation": "Asenqes n wakud n ovulation, ɣef talɣut yellan.",
"awaADeux.partnerSide.profile.faq.termNextPeriod": "Lḥiḍ i d-iteddun (asenqes)",
"awaADeux.partnerSide.profile.faq.descriptionNextPeriod": "Azemz yettwanqes n tazwara n lḥiḍ-is i d-iteddun.",
"awaADeux.partnerSide.profile.faq.termPeriodStatus": "Addad n lḥiḍ",
"awaADeux.partnerSide.profile.faq.descriptionPeriodStatus": "Isken ma lḥiḍ-is yettkemmil tura neɣ yekfa.",
"awaADeux.partnerSide.profile.faq.troubleshootingTitle": "Ɣur-i ugur d AWA Together",
"awaADeux.partnerSide.profile.faq.troubleshootingDescription": "Ayen ara txedmeḍ ma talɣut ur d-tettban ara, ma yella uqqen yettban-d yeḥbes, neɣ ma tesɛiḍ ugur-nniḍen.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph1": "Ma kra n talɣut ur d-tettban ara, bdu s usenqed ma uqqen-ik n internet iteddu akken iwata.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph2": "Kra n talɣut zemren ad ttuxṣen kan acku amdan-ik ur tt-ibeḍḍu ara tura.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph3": "Tzemreḍ daɣen ad tɛerḍeḍ ad tmedleḍ usnas ad t-teldiḍ i tikelt-nniḍen.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph4": "Ma ugur yettkemmil, tzemreḍ ad tnermseḍ asenfar n AWA.",
"awaADeux.partnerSide.profile.faq.contactSupportTitle": "Nermes asenfar",
"awaADeux.partnerSide.profile.faq.contactSupportDescription": "Teḥwaǧeḍ ugar n tallalt? Tarbaɛt-nneɣ tella dagi ad k-tɛawen.",
"awaADeux.partnerSide.profile.faq.contactSupportParagraph1": "Ma tesɛiḍ asteqsi, ma teffeḍ ɣer ugur, neɣ tebɣiḍ ad aɣ-d-tefkeḍ tamuɣli-ik, tzemreḍ ad tnermseḍ tarbaɛt n AWA seg tezɣelt-a.",
"awaADeux.partnerSide.profile.faq.contactSupportParagraph2": "Tanemmirt imi i aɣ-tɛawneḍ ad nesnerni AWA! 💜",
"awaADeux.partnerSide.profile.faq.contactButton": "Aru-aɣ-d",
"awaADeux.partnerSide.profile.faq.contactAccessibility": "Nermes-aɣ s imayl",
