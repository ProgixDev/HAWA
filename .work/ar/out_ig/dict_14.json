"awaADeux.partnerSide.profile.faq.howItWorksTitle": "Kedu ka AWA Ọnụ si arụ ọrụ?",
"awaADeux.partnerSide.profile.faq.howItWorksDescription": "Mụta ka ngwa a si enyere gị aka ịkwado onye òtù gị ma na-asọpụrụ nzuzo ya.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph1": "AWA Ọnụ na-enye gị ohere ịhụ naanị ozi onye òtù gị họrọ ikekọrịta na gị.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph2": "Dịka ọmụmaatụ, ị nwere ike ịhụ ụfọdụ ozi gbasara okirikiri ya, nsọ ya na-abịa, ma ọ bụ oge ịmụ nwa ya mgbe a gbanyere ikekọrịta maka ha.",
"awaADeux.partnerSide.profile.faq.howItWorksParagraph3": "Ozi a na-ahụ na-adabere mgbe niile na nhọrọ ya. Ọ nwere ike ịgbanwe ihe ọ na-ekekọrịta n’oge ọ bụla.",
"awaADeux.partnerSide.profile.faq.hiddenInfoTitle": "Gịnị mere a na-ezo ụfọdụ ozi?",
"awaADeux.partnerSide.profile.faq.hiddenInfoDescription": "Onye òtù gị na-ahọrọ ihe ọ na-ekekọrịta na gị. Ọ nwere ike ịgbanwe nhọrọ ndị a n’oge ọ bụla.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph1": "Onye òtù gị na-achịkwa ozi ọ chọrọ ikekọrịta na gị.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph2": "Ọ bụrụ na ozi anaghị apụta n’oghere gị, ọ nwere ike ịbụ na ọ họrọghị ikekọrịta ya.",
"awaADeux.partnerSide.profile.faq.hiddenInfoParagraph3": "Nhọrọ ya nwere ike ịgbanwe n’oge ọ bụla. AWA Ọnụ na-egosi gị naanị ozi ị nwere ohere ịnweta ugbu a.",
"awaADeux.partnerSide.profile.faq.understandingTitle": "Ịghọta ozi ekekọrịtara",
"awaADeux.partnerSide.profile.faq.understandingDescription": "Nkọwa dị mfe gbasara ụbọchị okirikiri, ọkwa ugbu a, oge ịmụ nwa, ovulation a tụrụ anya, na nsọ na-abịa.",
"awaADeux.partnerSide.profile.faq.understandingIntro": "Nke a bụ ihe ozi ekekọrịtara na gị nwere ike ịpụta:",
"awaADeux.partnerSide.profile.faq.termCycleDay": "Ụbọchị okirikiri",
"awaADeux.partnerSide.profile.faq.descriptionCycleDay": "Na-egosi ọnụ ọgụgụ ụbọchị kemgbe mmalite nsọ ya ikpeazụ.",
"awaADeux.partnerSide.profile.faq.termCurrentPhase": "Ọkwa ugbu a",
"awaADeux.partnerSide.profile.faq.descriptionCurrentPhase": "Na-egosi ọkwa okirikiri ugbu a mgbe ọ dị.",
"awaADeux.partnerSide.profile.faq.termFertileWindow": "Oge ịmụ nwa",
"awaADeux.partnerSide.profile.faq.descriptionFertileWindow": "Oge a tụrụ anya nke ohere ịtụrụ ime nwere ike ịdị elu.",
"awaADeux.partnerSide.profile.faq.termOvulation": "Ovulation a tụrụ anya",
"awaADeux.partnerSide.profile.faq.descriptionOvulation": "Atụmatụ oge ovulation na-eme, dabere n’ozi dị.",
"awaADeux.partnerSide.profile.faq.termNextPeriod": "Nsọ na-abịa a tụrụ anya",
"awaADeux.partnerSide.profile.faq.descriptionNextPeriod": "Ụbọchị a tụrụ anya nke mmalite nsọ ya na-abịa.",
"awaADeux.partnerSide.profile.faq.termPeriodStatus": "Ọnọdụ nsọ",
"awaADeux.partnerSide.profile.faq.descriptionPeriodStatus": "Na-egosi ma nsọ ya na-aga n’ihu ugbu a ka ọ agwụla.",
"awaADeux.partnerSide.profile.faq.troubleshootingTitle": "Enwere m nsogbu na AWA Ọnụ",
"awaADeux.partnerSide.profile.faq.troubleshootingDescription": "Ihe ị ga-eme ma ozi anaghị egosi, njikọ dị ka nke akwụsịrị, ma ọ bụ ị nwere nsogbu ọzọ.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph1": "Ọ bụrụ na ụfọdụ ozi anaghị egosi, malite site n’ilele ma njikọ intaneti gị na-arụ ọrụ nke ọma.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph2": "Ụfọdụ ozi nwekwara ike ịnọghị naanị n’ihi na onye òtù gị anaghị ekekọrịta ha ugbu a.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph3": "Ị nwekwara ike ịnwa imechi ma meghee ngwa ahụ ọzọ.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph4": "Ọ bụrụ na nsogbu ahụ adịgide, ị ga-enwe ike ịkpọtụrụ nkwado AWA.",
"awaADeux.partnerSide.profile.faq.contactSupportTitle": "Kpọtụrụ nkwado",
"awaADeux.partnerSide.profile.faq.contactSupportDescription": "Ịchọrọ enyemaka ọzọ? Otu anyị nọ ebe a ịkwado gị.",
"awaADeux.partnerSide.profile.faq.contactSupportParagraph1": "Ọ bụrụ na ị nwere ajụjụ, nwee nsogbu, ma ọ bụ chọọ inye anyị echiche, ị nwere ike ịkpọtụrụ otu AWA site n’ngalaba a.",
"awaADeux.partnerSide.profile.faq.contactSupportParagraph2": "Daalụ maka inyere anyị aka imeziwanye AWA! 💜",
"awaADeux.partnerSide.profile.faq.contactButton": "Dee anyị",
