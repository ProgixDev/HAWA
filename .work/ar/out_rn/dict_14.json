"awaADeux.partnerSide.profile.faq.descriptionFertileWindow": "Igihe kigereranijwe aho amahirwe yo gusama ashobora kuba menshi.",
"awaADeux.partnerSide.profile.faq.termOvulation": "Ovulation igereranijwe",
"awaADeux.partnerSide.profile.faq.descriptionOvulation": "Igereranya ry’igihe ovulation ibera, rishingiye ku makuru aboneka.",
"awaADeux.partnerSide.profile.faq.termNextPeriod": "Imihango izoza igereranijwe",
"awaADeux.partnerSide.profile.faq.descriptionNextPeriod": "Itariki igereranijwe y’itangura ry’imihango yiwe izoza.",
"awaADeux.partnerSide.profile.faq.termPeriodStatus": "Uko imihango ihagaze",
"awaADeux.partnerSide.profile.faq.descriptionPeriodStatus": "Cerekana nimba imihango yiwe iraba ubu canke yarangiye.",
"awaADeux.partnerSide.profile.faq.troubleshootingTitle": "Mfise ikibazo kuri AWA Hamwe",
"awaADeux.partnerSide.profile.faq.troubleshootingDescription": "Ivyo gukora nimba amakuru adagaragara, ihuzwa risa n’iryahagaze, canke ufise ikindi kibazo.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph1": "Nimba amakuru amwe adagaragara, banza urabe ko interineti yawe ikora neza.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph2": "Amakuru amwe ashobora kandi kuba adahari kubera ko uwo mubana atayasangiza none.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph3": "Ushobora kandi kugerageza gufunga no gufungura porogaramu kandi.",
"awaADeux.partnerSide.profile.faq.troubleshootingParagraph4": "Nimba ikibazo gisigaye, uzobasha kuvugana n’ubufasha bwa AWA.",
"awaADeux.partnerSide.profile.faq.contactSupportTitle": "Vugana n’ubufasha",
"awaADeux.partnerSide.profile.faq.contactSupportDescription": "Ukeneye ubufasha burushiriza? Itsinda ryacu ririho ngo rigufashe.",
"awaADeux.partnerSide.profile.faq.contactSupportParagraph1": "Nimba ufise ikibazo, wahuye n’ikibazo, canke ushaka kuduha ivyo utekereza, ushobora kuvugana n’itsinda rya AWA muri iki gice.",
