<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!--
      WAKE_LOCK is a normal (install-time, no prompt) permission that React Native's HeadlessJsTaskService needs so
      the CPU stays awake while the reminder-reschedule task runs (see AwaReminderRescheduleService). It is already
      present in the merged manifest through @notifee/react-native; it is declared here so this feature does not
      silently depend on a dependency's manifest. No other permission is added: no foreground service, no
      RECEIVE_BOOT_COMPLETED change (notifee core already handles reboot), no exact-alarm permission.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true" />

      <!--
        Discreet launcher identity ("Apparence discrète" in
        PrivacySecurityScreen.tsx / DiscreetLauncherScreen.tsx). Both aliases
        target the SAME .MainActivity — package identity, app data, and
        deep-link handling are all unaffected; only which launcher icon/name
        is visible changes. Exactly one of the two must be enabled at any
        time (enforced by DiscreetLauncherModule.kt via
        PackageManager#setComponentEnabledSetting), never both and never
        neither. "awa-launcher" ships enabled by default so a fresh install
        behaves exactly as before this feature existed.
      -->
      <activity-alias
        android:name=".LauncherAwa"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enabled="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <activity-alias
        android:name=".LauncherDiscreet"
        android:targetActivity=".MainActivity"
        android:label="@string/app_name_discreet"
        android:icon="@mipmap/ic_launcher_discreet"
        android:roundIcon="@mipmap/ic_launcher_discreet_round"
        android:enabled="false"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
      </activity-alias>

      <!--
        Re-arms reminders after events notifee core does not handle: time-zone change, clock change, app update.
        exported=false: these are protected system broadcasts, which the system delivers to a non-exported receiver;
        no other app can poke it. Starts AwaReminderRescheduleService (a bounded headless JS task, not a foreground
        service). See AwaReminderRescheduleReceiver.kt / src/services/reminderRescheduleTask.ts.
      -->
      <receiver
        android:name=".AwaReminderRescheduleReceiver"
        android:enabled="true"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.TIMEZONE_CHANGED" />
          <action android:name="android.intent.action.TIME_SET" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>

      <service
        android:name=".AwaReminderRescheduleService"
        android:exported="false" />
    </application>
</manifest>
